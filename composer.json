{
  "name": "vs-point/messenger-transport-mqtt",
  "version": "1.0.0",
  "type": "library",
  "description": "Symfony Messenger transport for the MQTT.",
  "license": [
    "MIT"
  ],
  "keywords": [
    "mqtt",
    "symfony",
    "messenger",
    "component",
    "symfony-messenger"
  ],
  "homepage": "https://github.com/vs-point/messenger-transport-mqtt",
  "authors": [
    {
      "name": "Vít Steklý",
      "email": "stekly.vit@vs-point.cz",
      "homepage": "https://www.vs-point.cz"
    }
  ],
  "require": {
    "php": ">=8.2",
    "php-mqtt/client": "^1.0",
    "symfony/messenger": "^7.0|^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "symplify/easy-coding-standard": "^12.0"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "VSPoint\\Messenger\\Transport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VSPoint\\Messenger\\Transport\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
